rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    // CHANGE the e-mail below to the owner's Google account before deploying.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['skandasaitimeworld@gmail.com'];
    }
    function okStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function okSlot(s) {
      return s in ['Morning (9:30-12)', 'Afternoon (12-4)', 'Evening (4-9)'];
    }
    function okStatus(s) {
      return s in ['Booked', 'Received', 'Repairing', 'Ready', 'Delivered', 'Cancelled'];
    }
    function isBlocked(dateStr) {
      let p = /databases/$(database)/documents/settings/availability;
      return exists(p) && dateStr in get(p).data.get('blocked', []);
    }

    // ---- bookings: public may only CREATE; owner does the rest ----
    function validBooking(id) {
      let d = request.resource.data;
      return id.matches('^[A-Z2-9]{8}$')
        && d.keys().hasOnly(['name', 'phone', 'clockType', 'date', 'dateStr', 'slot', 'address', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'clockType', 'date', 'dateStr', 'slot', 'status', 'createdAt'])
        && okStr(d.name, 1, 60)
        && d.phone is string && d.phone.matches('^[0-9]{10}$')
        && d.clockType in ['big', 'small']
        && d.date is timestamp
        && d.date > request.time
        && d.date < request.time + duration.value(90, 'd')
        && d.dateStr is string && d.dateStr.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && !isBlocked(d.dateStr)
        && okSlot(d.slot)
        && d.status == 'Booked'
        && d.createdAt == request.time
        && ((d.clockType == 'big' && d.keys().hasAny(['address']) && okStr(d.address, 5, 200))
            || (d.clockType == 'small' && !d.keys().hasAny(['address'])));
    }

    match /bookings/{id} {
      allow create: if validBooking(id);
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || okStatus(request.resource.data.status));
    }

    // ---- tracking: public single-doc read. The doc ID is <bookingId>_<phone>,
    //      so you must know BOTH to read it. No public list. Holds no name/address. ----
    function validTracking(tid) {
      let d = request.resource.data;
      let bid = tid.split('_')[0];
      let b = getAfter(/databases/$(database)/documents/bookings/$(bid)).data;
      return tid.matches('^[A-Z2-9]{8}_[0-9]{10}$')
        && existsAfter(/databases/$(database)/documents/bookings/$(bid))
        && d.keys().hasOnly(['status', 'dateStr', 'slot', 'clockType', 'createdAt'])
        && d.keys().hasAll(['status', 'dateStr', 'slot', 'clockType', 'createdAt'])
        && d.status == 'Booked'
        && d.createdAt == request.time
        && b.phone == tid.split('_')[1]
        && b.dateStr == d.dateStr
        && b.slot == d.slot
        && b.clockType == d.clockType;
    }

    match /tracking/{tid} {
      allow get: if true;
      allow list, delete: if isOwner();
      allow create: if validTracking(tid);
      allow update: if isOwner()
        && okStatus(request.resource.data.status)
        && request.resource.data.keys().hasOnly(['status', 'dateStr', 'slot', 'clockType', 'createdAt']);
    }

    // ---- reminders: owner only ----
    match /reminders/{id} {
      allow read, write: if isOwner();
    }

    // ---- availability: public read, owner write ----
    match /settings/availability {
      allow read: if true;
      allow write: if isOwner();
    }

    // everything else: denied by default
  }
}
